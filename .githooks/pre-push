#!/bin/sh
# This WSL checkout publishes only the TB520FU branch to its own fork.
set -eu
case "${2:-}" in
    https://github.com/wnduddld0513/SteamOS-ARM-Port|https://github.com/wnduddld0513/SteamOS-ARM-Port.git|git@github.com:wnduddld0513/SteamOS-ARM-Port.git|ssh://git@github.com/wnduddld0513/SteamOS-ARM-Port.git) ;;
    *)
        echo "Push blocked: destination must be wnduddld0513/SteamOS-ARM-Port." >&2
        exit 1
        ;;
esac
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_ref" != refs/heads/main ] || [ "$remote_ref" != refs/heads/main ]; then
        echo "Push blocked: only main -> main is allowed (no other branches, tags or deletions)." >&2
        exit 1
    fi
done
