# This file is installed only into the TB520FU image. Stock SSC applies lapis orientation.
ACTION=="remove", GOTO="tb520fu_sensors_end"
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel ssc-light ssc-proximity", ENV{ACCEL_MOUNT_MATRIX}="1,0,0;0,1,0;0,0,1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iio-sensor-proxy.service"
LABEL="tb520fu_sensors_end"
